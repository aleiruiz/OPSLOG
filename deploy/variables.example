# Variables of the demo stack (docker-compose.yml). Copy to .env for a local run; on Coolify set
# them in the application's Environment Variables. Never commit real values.
OPSLOG_PUBLIC_ORIGIN=http://localhost:8081
# openssl rand -base64 48
OPSLOG_BFF_SECRET=
OPSLOG_GRANT_SECRET=
OPSLOG_MYSQL_ROOT_PASSWORD=
# Persistence: mysql (default) keeps all data in the database across restarts; memory loses it.
OPSLOG_PERSISTENCE=mysql
# openssl rand -base64 48 (at least 32 characters; derives the passwords of the restricted MySQL
# accounts. Changing it later is fine: the migrate job re-applies the new passwords on the next deploy.)
OPSLOG_MYSQL_SECRET=
# openssl rand -base64 32 (32 bytes). BACK IT UP: without it the personal data already stored
# (employees, incident parties) can never be read again.
OPSLOG_PII_MASTER_KEY=
# Optional; the database must be named opslog_t_<name>. Default: opslog_t_main.
# OPSLOG_MYSQL_DATABASE=opslog_t_main
# Optional: real file storage. OPSLOG_OBJECT_STORAGE=s3 plus the four values below.
OPSLOG_OBJECT_STORAGE=memory
OPSLOG_S3_BUCKET=
OPSLOG_S3_REGION=
OPSLOG_S3_ACCESS_KEY_ID=
OPSLOG_S3_SECRET_ACCESS_KEY=
# Sign-in. synthetic for a local run (nobody can really log in); set cognito on the VPS and fill the
# OPSLOG_OIDC_* values below. docker-compose.yml defaults to cognito when this is unset.
OPSLOG_AUTH_MODE=synthetic
# Cognito user pool and app client (confidential client, authorization code + PKCE).
# e.g. https://cognito-idp.<region>.amazonaws.com/<user pool id>
OPSLOG_OIDC_ISSUER=
# e.g. https://<prefix>.auth.<region>.amazoncognito.com
OPSLOG_OIDC_DOMAIN=
OPSLOG_OIDC_CLIENT_ID=
OPSLOG_OIDC_CLIENT_SECRET=
OPSLOG_OIDC_REDIRECT_URI=http://localhost:8081/auth/callback
# First company and its administrator (the Cognito sub); set both or neither. Safe to leave set.
OPSLOG_BOOTSTRAP_COMPANY=
OPSLOG_BOOTSTRAP_ADMIN_SUB=
# Sales page (landing service, docs/operations/LANDING.md). Password of user `admin` for
# /admin/leads, at least 16 characters (openssl rand -base64 24); empty hides the request list.
LANDING_ADMIN_PASSWORD=
# Optional https webhook told about every new demo request (Slack, Discord, n8n...).
LANDING_NOTIFY_URL=
# Address shown on the privacy notice for data requests.
LANDING_CONTACT_EMAIL=
