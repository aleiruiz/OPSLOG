{
  "name": "@opslog/persistence-tenancy",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test:unit": "vitest run src/index.test.ts --coverage.enabled --coverage.include=src/**/*.ts --coverage.exclude=**/*.test.ts --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.statements=95 --coverage.thresholds.branches=90",
    "test:integration": "vitest run src/mysql.integration.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@opslog/domain-tenants": "workspace:*",
    "mysql2": "3.22.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "vitest": "3.2.6"
  }
}
