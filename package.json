{
  "name": "opslog",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.13.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig*.json eslint.config.mjs .prettierrc.json apps/*/package.json tests/harness/*.{json,ts} .github/workflows/quality.yml",
    "typecheck": "tsc -b",
    "test:unit": "vitest run tests/harness/unit.test.ts --coverage.enabled --coverage.thresholds.lines=80",
    "test:integration": "vitest run tests/harness/mysql.integration.test.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "build": "tsc -b",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.2",
    "mysql2": "3.14.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2",
    "@vitest/coverage-v8": "3.1.2"
  }
}
