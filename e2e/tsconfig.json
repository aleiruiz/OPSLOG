{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "..",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@opslog/ui": ["packages/ui/src/index.ts"],
      "@opslog/contracts": ["packages/contracts/src/index.ts"]
    },
    "rootDir": "..",
    "types": ["node", "@playwright/test", "react", "react-dom"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../packages/ui/src/**/*.ts",
    "../packages/ui/src/**/*.tsx",
    "../packages/contracts/src/*.ts",
    "../packages/contracts/src/bff/*.ts",
    "../apps/web/api/**/*.ts",
    "../apps/web/app/**/*.ts",
    "../apps/web/app/**/*.tsx",
    "../apps/web/auth/**/*.tsx",
    "../apps/web/settings/**/*.tsx",
    "../apps/web/vehicles/**/*.ts",
    "../apps/web/vehicles/**/*.tsx",
    "../apps/web/areas/**/*.ts",
    "../apps/web/areas/**/*.tsx",
    "../apps/web/documents/**/*.ts",
    "../apps/web/documents/**/*.tsx",
    "../apps/web/insurance/**/*.ts",
    "../apps/web/insurance/**/*.tsx",
    "../apps/web/employees/**/*.ts",
    "../apps/web/employees/**/*.tsx"
  ],
  "exclude": [
    "../packages/ui/src/**/*.stories.tsx",
    "../packages/ui/src/**/*.test.tsx",
    "../packages/contracts/src/*.test.ts",
    "../apps/web/**/*.test.ts",
    "../apps/web/**/*.test.tsx",
    "../apps/web/app/test/**"
  ]
}
